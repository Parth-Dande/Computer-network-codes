#include <iostream>
#include <string>
#include <cmath>
using namespace std;

int main() {
    string input;

    cout << "Enter 4 bit binary data: ";
    cin >> input;

    if (input.length() != 4) {
        cout << "Invalid input. Enter exactly 4 bits." << endl;
        return 0;
    }

    for (char c : input) {
        if (c != '0' && c != '1') {
            cout << "Invalid input. Only 0 and 1 are allowed." << endl;
            return 0;
        }
    }

    int dataBits = 4;
    int parityBits = 0;

    while ((1 << parityBits) < dataBits + parityBits + 1) {
        parityBits++;
    }

    cout << "Data Bits:" << input << endl;
    cout << "Number of Parity bits:" << parityBits << endl;

    char code[8];

    code[1] = 'P';
    code[2] = 'P';
    code[3] = input[3];
    code[4] = 'P';
    code[5] = input[2];
    code[6] = input[1];
    code[7] = input[0];

    cout << "\nHamming code positions:" << endl;

    for (int pos = 1; pos <= 7; pos++) {
        cout << "Position " << pos << ": " << code[pos] << endl;
    }

    int parityPos = 1;

    while (parityPos <= 4) {
        int parityValue = 0;

        cout << "P" << parityPos << " checks positions: ";

        for (int pos = 1; pos <= 7; pos++) {
            if ((pos & parityPos) != 0) {
                cout << pos << " ";

                if (pos != parityPos) {
                    parityValue ^= (code[pos] - '0');
                }
            }
        }

        code[parityPos] = parityValue + '0';

        cout << "-> P" << parityPos
             << " = " << code[parityPos] << endl;

        parityPos *= 2;
    }

    cout << "\nParity Bits:" << endl;
    cout << "P1 = " << code[1] << endl;
    cout << "P2 = " << code[2] << endl;
    cout << "P3 = " << code[4] << endl;

    cout << "\nFinal Hamming Code: ";

    for (int pos = 1; pos <= 7; pos++) {
        cout << code[pos];
    }

    cout << endl;

    return 0;
}f
